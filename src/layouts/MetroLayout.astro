---
// SPDX-License-Identifier: MPL-2.0
import { ClientRouter } from 'astro:transitions';
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
import FancyboxManager from '@/components/FancyboxManager.astro';
import RepoCardRenderer from '@/components/RepoCardRenderer.astro';
import { siteConfig } from '@/config';
import '@fontsource-variable/noto-sans';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/jetbrains-mono';
import '@/styles/metro.css';

interface Props { title?: string; description?: string }
const {
  title = 'Clina 的笔记本',
  description = 'ClinaSaMa 的个人站点，使用 Mosaic 主题。',
} = Astro.props;

const defaultHue = siteConfig.themeColor.hue;
const themeFixed = siteConfig.themeColor.fixed;
---

<!doctype html>
<html lang="zh-CN" style={`--hue:${defaultHue}`} data-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="b0aad9b4-7587-4b16-a7f5-14999733afad"></script>
    <script is:inline set:html={`
      (() => {
        try {
          const hue = localStorage.getItem('hue') || '${defaultHue}';
          document.documentElement.style.setProperty('--hue', hue);
          const saved = localStorage.getItem('mode');
          const mode = saved === 'light' || saved === 'dark'
            ? saved
            : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-mode', mode);
        } catch {
          document.documentElement.setAttribute('data-mode', 'dark');
        }
      })();
    `}></script>
    <ClientRouter />
  </head>
  <body>
    {!themeFixed && <ThemeSwitcher />}
    <slot />
    <FancyboxManager />
    <RepoCardRenderer />
  </body>
</html>

<style is:global>
  ::view-transition-old(root) { animation: metro-out .3s ease-in both; }
  ::view-transition-new(root) { animation: metro-in .35s ease-out both; }
  @keyframes metro-out { to { transform: translateX(-30px); opacity: 0; } }
  @keyframes metro-in  { from { transform: translateX(30px); opacity: 0; } }
</style>
